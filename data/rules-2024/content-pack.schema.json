{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas 2024 content pack",
  "description": "Additive user content. Runtime additionally checks nonempty records, IDs, foreign keys, ownership, limits, and localization; schema alone does not validate game-rule correctness.",
  "$defs": {
    "localized": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "el": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "el"
      ],
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "properties": {
        "action_type": {
          "enum": [
            "Action",
            "Bonus Action",
            "Reaction",
            "Magic Action",
            "Attack Replacement",
            "Passive",
            "Triggered",
            "Utilize"
          ]
        },
        "uses_formula": {
          "type": "string",
          "minLength": 1
        },
        "recharge": {
          "enum": [
            "Short Rest",
            "Long Rest",
            "Short or Long Rest",
            "None"
          ]
        },
        "duration": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action_type",
        "uses_formula",
        "recharge"
      ]
    },
    "spellGrant": {
      "type": "object",
      "properties": {
        "spell_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "unlock_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "casting_ability_choice_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "always_prepared": {
          "type": "boolean"
        },
        "uses_spell_slots": {
          "type": "boolean"
        },
        "free_casts_formula": {
          "type": "string",
          "minLength": 1
        },
        "recharge": {
          "enum": [
            "Long Rest",
            "Short Rest",
            "Short or Long Rest",
            "None"
          ]
        },
        "replacement": {
          "type": "object"
        }
      },
      "required": [
        "spell_id",
        "unlock_level",
        "casting_ability_choice_id",
        "always_prepared",
        "uses_spell_slots"
      ]
